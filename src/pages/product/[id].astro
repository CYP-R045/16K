---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
  return products.map(p => ({ params: { id: String(p.id) } }));
}

const { id } = Astro.params;
const product = products.find(p => p.id === Number(id))!;
---
<Layout title={`16K — ${product.name}`}>
  <Nav />

  <main class="pdp">
    <a href="/shop" class="pdp__back">← Back to shop</a>

    <div class="pdp__layout">
      <!-- Gallery -->
      <div class="pdp__gallery">
        <div class="pdp__main-wrap">
          <img
            id="mainImg"
            src={product.gallery[0]}
            alt={product.name}
            class="pdp__main-img"
          />
        </div>
        <div class="pdp__thumbs">
          {product.gallery.map((src, i) => (
            <button
              class={`pdp__thumb${i === 0 ? ' active' : ''}`}
              data-src={src}
              aria-label={`View image ${i + 1}`}
            >
              <img src={src} alt={`${product.name} view ${i + 1}`} />
            </button>
          ))}
        </div>
      </div>

      <!-- Info -->
      <div class="pdp__info">
        <p class="pdp__category">16K ORIGINALS</p>
        <h1 class="pdp__name">{product.name.toUpperCase()}</h1>
        <p class="pdp__size">{product.size}</p>
        <p class="pdp__price">{product.price}</p>
        <p class="pdp__desc">{product.description}</p>
        <button
          class="pdp__btn"
          id="addToCart"
          data-id={product.id}
          data-name={product.name}
          data-size={product.size}
          data-price={product.price}
          data-img={product.img}
        >ADD TO CART</button>
        <p class="pdp__note">Custom piece — made to order. Allow 2–4 weeks.</p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .pdp {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .pdp__back {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #666;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }
  .pdp__back:hover { color: #000; }

  .pdp__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Gallery */
  .pdp__main-wrap {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #f5f5f5;
  }
  .pdp__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: opacity 0.25s ease;
  }
  .pdp__main-img.swapping { opacity: 0; }

  .pdp__thumbs {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
  .pdp__thumb {
    flex: 1;
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color 0.2s;
    cursor: pointer;
    background: #f0f0f0;
  }
  .pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .pdp__thumb.active { border-color: #000; }
  .pdp__thumb:hover { border-color: #999; }
  .pdp__thumb.active:hover { border-color: #000; }

  /* Info */
  .pdp__info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 90px;
  }

  .pdp__category {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: #999;
  }

  .pdp__name {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1.1;
  }

  .pdp__size {
    font-size: 0.9rem;
    color: #555;
    font-weight: 500;
  }

  .pdp__price {
    font-size: 1.3rem;
    font-weight: 700;
  }

  .pdp__desc {
    font-size: 0.875rem;
    color: #444;
    line-height: 1.75;
    border-top: 1px solid #e5e5e5;
    padding-top: 1rem;
  }

  .pdp__btn {
    margin-top: 0.5rem;
    background: #000;
    color: #fff;
    padding: 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    width: 100%;
    transition: opacity 0.2s;
    cursor: pointer;
    font-family: inherit;
    border: none;
  }
  .pdp__btn:hover { opacity: 0.75; }

  .pdp__note {
    font-size: 0.72rem;
    color: #999;
    text-align: center;
    letter-spacing: 0.03em;
  }

  @media (max-width: 700px) {
    .pdp__layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .pdp__info { position: static; }
  }
</style>

<script>
  import { addToCart } from '../../scripts/cart';

  // Gallery swap
  const mainImg = document.getElementById('mainImg') as HTMLImageElement;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.pdp__thumb');

  thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.src!;
      if (mainImg.src.endsWith(src)) return;
      mainImg.classList.add('swapping');
      setTimeout(() => {
        mainImg.src = src;
        mainImg.classList.remove('swapping');
      }, 250);
      thumbs.forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
    });
  });

  // Add to cart
  const btn = document.getElementById('addToCart') as HTMLButtonElement;
  btn.addEventListener('click', () => {
    const { id, name, size, price, img } = btn.dataset;
    addToCart({ id: Number(id), name: name!, size: size!, price: price!, img: img! });

    btn.textContent = 'ADDED ✓';
    btn.style.opacity = '0.6';
    setTimeout(() => {
      btn.textContent = 'ADD TO CART';
      btn.style.opacity = '';
    }, 1800);
  });
</script>
