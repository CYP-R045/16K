---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getAllProducts, getProductByHandle, productMeta, formatPrice } from '../../lib/shopify';

export async function getStaticPaths() {
  const products = await getAllProducts();
  return products.map((p: any) => ({ params: { id: p.handle } }));
}

const { id } = Astro.params;
const product = await getProductByHandle(id!);

if (!product) return Astro.redirect('/shop');

const meta     = productMeta[product.handle] ?? { models: [], color: 'unknown', category: 'jorts' };
const shopifyImgs: string[] = product.images.edges.map((e: any) => e.node.url);
const gallery  = [...shopifyImgs, ...meta.models].filter(Boolean);
const variants = product.variants.edges.map((e: any) => e.node);
const price    = formatPrice(product.priceRange.minVariantPrice.amount, product.priceRange.minVariantPrice.currencyCode);
---
<Layout title={`16K — ${product.title}`}>
  <Nav />

  <main class="pdp">
    <a href="/shop" class="pdp__back">← Back to shop</a>

    <div class="pdp__layout">
      <!-- Gallery -->
      <div class="pdp__gallery">
        <div class="pdp__main-wrap">
          <img id="mainImg" src={gallery[0]} alt={product.title} class="pdp__main-img" />
        </div>
        <div class="pdp__thumbs">
          {gallery.map((src: string, i: number) => (
            <button class={`pdp__thumb${i === 0 ? ' active' : ''}`} data-src={src} aria-label={`View image ${i + 1}`}>
              <img src={src} alt={`${product.title} view ${i + 1}`} />
            </button>
          ))}
        </div>
      </div>

      <!-- Info -->
      <div class="pdp__info">
        <p class="pdp__category">16K ORIGINALS</p>
        <h1 class="pdp__name">{product.title.toUpperCase()}</h1>
        <p class="pdp__price">{price}</p>

        <!-- Variant picker -->
        {variants.length > 1 && (
          <div class="pdp__variants">
            <p class="pdp__variants-label">SIZE</p>
            <div class="pdp__variant-btns">
              {variants.map((v: any, i: number) => (
                <button
                  class={`variant-btn${i === 0 ? ' active' : ''}`}
                  data-variant-id={v.id}
                  disabled={!v.availableForSale}
                >
                  {v.title}
                </button>
              ))}
            </div>
          </div>
        )}

        <p class="pdp__desc">{product.description}</p>

        <button
          class="pdp__btn"
          id="addToCart"
          data-variant-id={variants[0]?.id}
        >ADD TO CART</button>

        <p class="pdp__note">Custom piece — made to order. Allow 2–4 weeks.</p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .pdp {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .pdp__back {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #666;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }
  .pdp__back:hover { color: #000; }

  .pdp__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .pdp__main-wrap {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #f5f5f5;
  }
  .pdp__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: opacity 0.25s ease;
  }
  .pdp__main-img.swapping { opacity: 0; }

  .pdp__thumbs {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
  .pdp__thumb {
    flex: 1;
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color 0.2s;
    cursor: pointer;
    background: #f0f0f0;
  }
  .pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .pdp__thumb.active { border-color: #000; }
  .pdp__thumb:hover  { border-color: #999; }
  .pdp__thumb.active:hover { border-color: #000; }

  .pdp__info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 90px;
  }
  .pdp__category {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: #999;
  }
  .pdp__name {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1.1;
  }
  .pdp__price {
    font-size: 1.3rem;
    font-weight: 700;
  }

  /* Variant picker */
  .pdp__variants { border-top: 1px solid #e5e5e5; padding-top: 1rem; }
  .pdp__variants-label {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #999;
    margin-bottom: 0.6rem;
  }
  .pdp__variant-btns { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .variant-btn {
    padding: 0.45rem 1rem;
    border: 1.5px solid #ddd;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    font-family: inherit;
    background: #fff;
  }
  .variant-btn:hover  { border-color: #000; }
  .variant-btn.active { border-color: #000; background: #000; color: #fff; }
  .variant-btn:disabled { opacity: 0.35; cursor: not-allowed; }

  .pdp__desc {
    font-size: 0.875rem;
    color: #444;
    line-height: 1.75;
    border-top: 1px solid #e5e5e5;
    padding-top: 1rem;
  }
  .pdp__btn {
    margin-top: 0.5rem;
    background: #000;
    color: #fff;
    padding: 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    width: 100%;
    transition: opacity 0.2s;
    cursor: pointer;
    font-family: inherit;
    border: none;
  }
  .pdp__btn:hover { opacity: 0.75; }
  .pdp__btn:disabled { opacity: 0.5; cursor: default; }

  .pdp__note {
    font-size: 0.72rem;
    color: #999;
    text-align: center;
    letter-spacing: 0.03em;
  }

  @media (max-width: 700px) {
    .pdp__layout { grid-template-columns: 1fr; gap: 2rem; }
    .pdp__info { position: static; }
  }
</style>

<script>
  import { addToCart } from '../../scripts/cart';

  // Gallery swap
  const mainImg = document.getElementById('mainImg') as HTMLImageElement;
  const thumbs  = document.querySelectorAll<HTMLButtonElement>('.pdp__thumb');

  thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.src!;
      if (mainImg.src === src) return;
      mainImg.classList.add('swapping');
      setTimeout(() => { mainImg.src = src; mainImg.classList.remove('swapping'); }, 250);
      thumbs.forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
    });
  });

  // Variant selection
  const variantBtns = document.querySelectorAll<HTMLButtonElement>('.variant-btn');
  const addToCartBtn = document.getElementById('addToCart') as HTMLButtonElement;

  variantBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      variantBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      addToCartBtn.dataset.variantId = btn.dataset.variantId;
    });
  });

  // Add to cart
  addToCartBtn.addEventListener('click', async () => {
    const variantId = addToCartBtn.dataset.variantId!;
    addToCartBtn.disabled = true;
    addToCartBtn.textContent = 'ADDING...';
    try {
      await addToCart(variantId);
      addToCartBtn.textContent = 'ADDED ✓';
      setTimeout(() => {
        addToCartBtn.textContent = 'ADD TO CART';
        addToCartBtn.disabled = false;
      }, 1800);
    } catch (e) {
      addToCartBtn.textContent = 'TRY AGAIN';
      addToCartBtn.disabled = false;
    }
  });
</script>
