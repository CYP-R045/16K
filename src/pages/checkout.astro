---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="16K — Cart">
  <Nav />

  <main class="checkout">
    <a href="/shop" class="checkout__back">← Continue shopping</a>
    <h1 class="checkout__title">YOUR CART</h1>

    <div class="checkout__layout" id="cartLayout">
      <div class="checkout__items" id="cartItems"></div>

      <div class="checkout__sidebar">
        <div class="checkout__summary" id="cartSummary"></div>
        <button class="checkout__submit" id="checkoutBtn">PROCEED TO CHECKOUT</button>
        <p class="checkout__note">You'll complete payment securely on Shopify.</p>
      </div>
    </div>

    <div class="checkout__empty" id="cartEmpty" style="display:none">
      <p>Your cart is empty.</p>
      <a href="/shop" class="checkout__shop-link">SHOP NOW</a>
    </div>

    <div class="checkout__loading" id="cartLoading">
      <p>Loading cart...</p>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .checkout {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }
  .checkout__back {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #666;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }
  .checkout__back:hover { color: #000; }

  .checkout__title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    margin-bottom: 2.5rem;
  }

  .checkout__layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3rem;
    align-items: start;
  }

  .checkout__items { display: flex; flex-direction: column; gap: 1.25rem; }

  .cart-row {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #e5e5e5;
  }
  .cart-row__img {
    width: 80px;
    height: 100px;
    object-fit: cover;
    object-position: top;
    background: #f5f5f5;
  }
  .cart-row__name { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.25rem; }
  .cart-row__variant { font-size: 0.8rem; color: #666; margin-bottom: 0.5rem; }
  .cart-row__qty {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .cart-row__qty button {
    width: 24px;
    height: 24px;
    border: 1px solid #ccc;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    cursor: pointer;
    transition: border-color 0.15s;
    line-height: 1;
    background: none;
  }
  .cart-row__qty button:hover { border-color: #000; }
  .cart-row__price { font-size: 0.95rem; font-weight: 600; white-space: nowrap; }
  .cart-row__remove {
    font-size: 0.7rem;
    color: #aaa;
    cursor: pointer;
    margin-top: 0.4rem;
    text-decoration: underline;
    transition: color 0.15s;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
  }
  .cart-row__remove:hover { color: #000; }

  .checkout__sidebar {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .checkout__summary {
    border: 1px solid #e5e5e5;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #555;
  }
  .summary-row--total {
    font-size: 1rem;
    font-weight: 700;
    color: #000;
    border-top: 1px solid #e5e5e5;
    padding-top: 0.75rem;
    margin-top: 0.15rem;
  }

  .checkout__submit {
    background: #000;
    color: #fff;
    padding: 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    width: 100%;
    cursor: pointer;
    font-family: inherit;
    border: none;
    transition: opacity 0.2s;
  }
  .checkout__submit:hover { opacity: 0.75; }
  .checkout__submit:disabled { opacity: 0.4; cursor: default; }

  .checkout__note {
    font-size: 0.7rem;
    color: #aaa;
    text-align: center;
    line-height: 1.6;
  }

  .checkout__empty {
    text-align: center;
    padding: 5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    color: #666;
  }
  .checkout__shop-link {
    background: #000;
    color: #fff;
    padding: 0.85rem 2rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    transition: opacity 0.2s;
  }
  .checkout__shop-link:hover { opacity: 0.75; }

  .checkout__loading {
    text-align: center;
    padding: 5rem 0;
    color: #999;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  @media (max-width: 720px) {
    .checkout__layout { grid-template-columns: 1fr; }
    .checkout__sidebar { position: static; }
  }
</style>

<script>
  import { getCart, updateCartLine, removeCartLine } from '../scripts/cart';

  const layoutEl  = document.getElementById('cartLayout')!;
  const itemsEl   = document.getElementById('cartItems')!;
  const summaryEl = document.getElementById('cartSummary')!;
  const emptyEl   = document.getElementById('cartEmpty')!;
  const loadingEl = document.getElementById('cartLoading')!;
  const checkoutBtn = document.getElementById('checkoutBtn') as HTMLButtonElement;

  let checkoutUrl = '';

  function fmt(amount: string, currency: string) {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(Number(amount));
  }

  async function render() {
    loadingEl.style.display = 'block';
    layoutEl.style.display  = 'none';
    emptyEl.style.display   = 'none';

    const cart = await getCart();

    loadingEl.style.display = 'none';

    if (!cart || cart.totalQuantity === 0) {
      emptyEl.style.display = 'flex';
      return;
    }

    checkoutUrl = cart.checkoutUrl;
    layoutEl.style.display = '';

    const lines = cart.lines.edges.map((e: any) => e.node);

    itemsEl.innerHTML = lines.map((line: any) => {
      const v = line.merchandise;
      const img = v.product.images.edges[0]?.node.url ?? '';
      const lineTotal = fmt(String(Number(v.price.amount) * line.quantity), v.price.currencyCode);
      return `
        <div class="cart-row">
          ${img ? `<img src="${img}" alt="${v.product.title}" class="cart-row__img" />` : '<div class="cart-row__img"></div>'}
          <div>
            <p class="cart-row__name">${v.product.title.toUpperCase()}</p>
            <p class="cart-row__variant">${v.title !== 'Default Title' ? v.title : ''}</p>
            <div class="cart-row__qty">
              <button class="qty-dec" data-line="${line.id}" data-qty="${line.quantity}">−</button>
              <span>${line.quantity}</span>
              <button class="qty-inc" data-line="${line.id}" data-qty="${line.quantity}">+</button>
            </div>
            <button class="cart-row__remove" data-line="${line.id}">Remove</button>
          </div>
          <p class="cart-row__price">${lineTotal}</p>
        </div>
      `;
    }).join('');

    const total = fmt(cart.cost.totalAmount.amount, cart.cost.totalAmount.currencyCode);
    summaryEl.innerHTML = `
      <div class="summary-row"><span>Items (${cart.totalQuantity})</span><span>${total}</span></div>
      <div class="summary-row"><span>Shipping</span><span>Calculated at checkout</span></div>
      <div class="summary-row summary-row--total"><span>TOTAL</span><span>${total}</span></div>
    `;

    // Qty controls
    document.querySelectorAll<HTMLButtonElement>('.qty-dec').forEach(btn => {
      btn.addEventListener('click', async () => {
        const qty = Number(btn.dataset.qty);
        if (qty <= 1) { await removeCartLine(btn.dataset.line!); }
        else { await updateCartLine(btn.dataset.line!, qty - 1); }
        render();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.qty-inc').forEach(btn => {
      btn.addEventListener('click', async () => {
        await updateCartLine(btn.dataset.line!, Number(btn.dataset.qty) + 1);
        render();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.cart-row__remove').forEach(btn => {
      btn.addEventListener('click', async () => {
        await removeCartLine(btn.dataset.line!);
        render();
      });
    });
  }

  render();
  window.addEventListener('cart-updated', () => render());

  checkoutBtn.addEventListener('click', () => {
    if (checkoutUrl) window.location.href = checkoutUrl;
  });
</script>
