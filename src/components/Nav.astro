---
---
<nav class="nav">
  <button class="nav__hamburger" aria-label="Menu">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <a href="/" class="nav__logo" id="navLogo">
    <video autoplay muted loop playsinline class="nav__logo-video" id="navVideo">
      <source src="/logo.mp4" type="video/mp4" />
    </video>
  </a>

  <div class="nav__right">
    <a href="/shop" class="nav__shop-link">SHOP</a>
    <a href="/checkout" class="nav__cart" aria-label="Cart">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"/>
        <circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 001.95 1.61h9.72a2 2 0 001.95-1.55l1.57-7.45H6"/>
      </svg>
      <span class="nav__cart-count" id="cartCount">0</span>
    </a>
  </div>
</nav>

<!-- Mobile drawer -->
<div class="drawer" id="drawer">
  <div class="drawer__inner">
    <button class="drawer__close" id="drawerClose" aria-label="Close">✕</button>

    <nav class="drawer__nav">
      <a href="/" class="drawer__link">HOME</a>
      <a href="/shop" class="drawer__link">SHOP</a>
      <a href="https://www.instagram.com/16k" target="_blank" rel="noopener" class="drawer__link">INSTAGRAM</a>
      <a href="mailto:adedijoakinloluwa@gmail.com" class="drawer__link">CONTACT</a>
    </nav>

    <div class="drawer__divider"></div>

    <p class="drawer__heading">CUSTOM ORDER</p>
    <p class="drawer__sub">Drop a description of the piece you want</p>
    <textarea class="drawer__textarea" placeholder="Describe your custom piece..."></textarea>
    <button class="drawer__submit">SUBMIT REQUEST</button>
  </div>
</div>
<div class="overlay" id="overlay"></div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e5e5e5;
  }

  .nav__hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 4px;
  }
  .nav__hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #000;
  }

  .nav__logo {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
  }

  .nav__logo-video {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav__shop-link {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    border-bottom: 1.5px solid transparent;
    padding-bottom: 1px;
    transition: border-color 0.2s;
  }
  .nav__shop-link:hover { border-bottom-color: #000; }

  .nav__cart {
    position: relative;
    padding: 4px;
    display: flex;
    align-items: center;
  }
  .nav__cart-count {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #000;
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    display: none;
  }

  /* Drawer */
  .drawer {
    position: fixed;
    top: 0;
    left: -100%;
    width: min(340px, 90vw);
    height: 100vh;
    background: #fff;
    z-index: 200;
    transition: left 0.3s ease;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .drawer.open { left: 0; }
  .drawer__close {
    align-self: flex-end;
    font-size: 1.2rem;
    padding: 4px 8px;
  }

  .drawer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }
  .drawer__link {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.6rem 0;
    border-bottom: 1px solid #f0f0f0;
    transition: opacity 0.15s;
  }
  .drawer__link:hover { opacity: 0.5; }

  .drawer__divider {
    height: 1px;
    background: #e0e0e0;
    margin: 0.75rem 0;
  }

  .drawer__heading {
    font-size: 1.4rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    margin-top: 1rem;
  }
  .drawer__sub {
    font-size: 0.85rem;
    color: #555;
    line-height: 1.5;
  }
  .drawer__textarea {
    width: 100%;
    height: 140px;
    border: 1.5px solid #000;
    padding: 0.75rem;
    font-family: inherit;
    font-size: 0.9rem;
    resize: none;
    outline: none;
    margin-top: 0.5rem;
  }
  .drawer__submit {
    background: #000;
    color: #fff;
    padding: 0.9rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    width: 100%;
    transition: opacity 0.2s;
  }
  .drawer__submit:hover { opacity: 0.8; }

  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 150;
  }
  .overlay.visible { display: block; }
</style>

<script>
  import { getCartCount } from '../scripts/cart';

  // --- Cart badge ---
  const cartCountEl = document.getElementById('cartCount')!;

  function syncCartBadge() {
    const count = getCartCount();
    cartCountEl.textContent = String(count);
    cartCountEl.style.display = count > 0 ? 'flex' : 'none';
  }

  syncCartBadge();
  window.addEventListener('cart-updated', syncCartBadge);

  // --- Drawer ---
  const hamburger = document.querySelector('.nav__hamburger');
  const drawer = document.getElementById('drawer');
  const overlay = document.getElementById('overlay');
  const drawerClose = document.getElementById('drawerClose');

  hamburger?.addEventListener('click', () => {
    drawer?.classList.add('open');
    overlay?.classList.add('visible');
  });

  const closeDrawer = () => {
    drawer?.classList.remove('open');
    overlay?.classList.remove('visible');
  };

  drawerClose?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
</script>
